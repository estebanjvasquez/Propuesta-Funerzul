# Funeraria del Zulia — configuración del sitio

# La portada es ahora index.php (renderiza las Preguntas Frecuentes desde la BD).
DirectoryIndex index.php index.html

# No listar el contenido de carpetas sin index (evita exponer los nombres de
# archivo de api/ vía "Index of /api/" -- ver auditoría SEO 2026-09-09).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Las redirecciones toman la carpeta real de la petición (%1) en vez de "/"
    # fijo: el sitio puede vivir en una subcarpeta (hoy /funerzul/ dentro de
    # legadoholding.com) y "/" mandaba a la raíz del dominio -- es decir, a
    # Legado Holding (reportado por el cliente 2026-10-27: "Inicio" y
    # "Preguntas Frecuentes" llevaban a Legado). THE_REQUEST (la línea original
    # del navegador) evita que la regla se dispare con la subpetición interna
    # de DirectoryIndex y entre en bucle.

    # Antigua portada estática -> portada actual (preserva SEO de enlaces ya indexados).
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*/)index\.html[?\s]
    RewriteRule ^index\.html$ %1 [R=301,L]
    # Consolida .../ e .../index.php en una sola URL canónica (evita contenido duplicado).
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*/)index\.php[?\s]
    RewriteRule ^index\.php$ %1 [R=301,L]
    # Plan Vanguardia Plus retirado (2026-10-27) -> hub de planes.
    RewriteCond %{REQUEST_URI} ^(.*/)planes/plan-vanguardia-plus\.php$
    RewriteRule ^planes/plan-vanguardia-plus\.php$ %1planes/ [R=301,L]
</IfModule>
