# Funeraria del Zulia — configuración del sitio

# La portada es ahora index.php (renderiza las Preguntas Frecuentes desde la BD).
DirectoryIndex index.php index.html

# No listar el contenido de carpetas sin index (evita exponer los nombres de
# archivo de api/ vía "Index of /api/" -- ver auditoría SEO 2026-09-09).
# -MultiViews: con MultiViews activo, Apache serviría o.php para /o/45/fb sin
# pasar por la regla de abajo (y sin el id); ver enlaces cortos más abajo.
Options -Indexes -MultiViews

# Copias de prueba fuera de Google (2026-11-02): nuevo.funerariadelzulia.com y
# legadoholding.com/funerzul/ servían el sitio con "index, follow" y competían
# con el dominio real. Solo aplica a esos hosts; www.funerariadelzulia.com no
# cambia.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Host "^(nuevo\.funerariadelzulia\.com|(www\.)?legadoholding\.com)$" FDZ_NOINDEX
    # La carpeta del ensayo vive dentro de public_html: también se ve como
    # www.funerariadelzulia.com/nuevo.funerariadelzulia.com/ (verificado 2026-11-02).
    SetEnvIfNoCase Request_URI "^/nuevo\.funerariadelzulia\.com(/|$)" FDZ_NOINDEX
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow" env=FDZ_NOINDEX
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dominio sin www -> www (301), conservando ruta y parámetros. Hasta el corte
    # lo hacía WordPress (x-redirect-by: WordPress, verificado 2026-11-02), no
    # Cloudflare: sin esta regla, funerariadelzulia.com serviría una copia del
    # sitio. http -> https lo hace Cloudflare ("Always Use HTTPS").
    RewriteCond %{HTTP_HOST} ^funerariadelzulia\.com$ [NC]
    RewriteRule ^(.*)$ https://www.funerariadelzulia.com/$1 [R=301,L,NE]

    # Las redirecciones toman la carpeta real de la petición (%1) en vez de "/"
    # fijo: el sitio puede vivir en una subcarpeta (hoy /funerzul/ dentro de
    # legadoholding.com) y "/" mandaba a la raíz del dominio -- es decir, a
    # Legado Holding (reportado por el cliente 2026-10-27: "Inicio" y
    # "Preguntas Frecuentes" llevaban a Legado). THE_REQUEST (la línea original
    # del navegador) evita que la regla se dispare con la subpetición interna
    # de DirectoryIndex y entre en bucle.

    # Antigua portada estática -> portada actual (preserva SEO de enlaces ya indexados).
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*/)index\.html[?\s]
    RewriteRule ^index\.html$ %1 [R=301,L]
    # Consolida .../ e .../index.php en una sola URL canónica (evita contenido duplicado).
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(.*/)index\.php[?\s]
    RewriteRule ^index\.php$ %1 [R=301,L]
    # Plan Vanguardia Plus retirado (2026-10-27) -> hub de planes.
    RewriteCond %{REQUEST_URI} ^(.*/)planes/plan-vanguardia-plus\.php$
    RewriteRule ^planes/plan-vanguardia-plus\.php$ %1planes/ [R=301,L]
    # Enlace corto de obituario para redes: o/45 y o/45/fb -> o.php (reescritura
    # interna; o.php cuenta el clic y redirige). Ver
    # docs/specs/2026-10-27-enlaces-redes-y-analitica.md.
    RewriteRule ^o/([0-9]+)(?:/([a-z]+))?/?$ o.php?id=$1&s=$2 [L,QSA]

    # --- URLs del WordPress anterior de www.funerariadelzulia.com (301) ---------
    # Para no perder posicionamiento ni enlaces compartidos al reemplazarlo. Ver
    # docs/specs/2026-10-28-migracion-dominio-final.md, sección 1.6. NE: no
    # escapar el "#" de las anclas.
    RewriteCond %{QUERY_STRING} ^(p|page_id|cat|s)=
    RewriteCond %{REQUEST_URI} ^(.*/)$
    RewriteRule ^$ %1? [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)nosotros/?$
    RewriteRule ^nosotros/?$ %1nosotros.php [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)preguntas-frecuentes/?$
    RewriteRule ^preguntas-frecuentes/?$ %1#preguntas [R=301,NE,L]
    RewriteCond %{REQUEST_URI} ^(.*/)crematorios-del-zulia/?$
    RewriteRule ^crematorios-del-zulia/?$ %1crematorios-del-zulia.php [R=301,L]
    # Previsión y la tienda WooCommerce (no funcionaba) -> planes.
    RewriteCond %{REQUEST_URI} ^(.*/)(familias-protegidas|tienda|carrito|finalizar-compra|mi-cuenta|producto|product)(/.*)?$
    RewriteRule ^(familias-protegidas|tienda|carrito|finalizar-compra|mi-cuenta|producto|product)(/.*)?$ %1planes/ [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)(testimonial|category/testimonial)(/.*)?$
    RewriteRule ^(testimonial|category/testimonial)(/.*)?$ %1#testimonios [R=301,NE,L]
    RewriteCond %{REQUEST_URI} ^(.*/)(category|tag|author|sample-page|feed|comments)(/.*)?$
    RewriteRule ^(category|tag|author|sample-page|feed|comments)(/.*)?$ %1 [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)[a-z_-]*sitemap[a-z0-9_-]*\.xml$
    RewriteRule ^[a-z_-]*sitemap[a-z0-9_-]*\.xml$ %1sitemap.php [R=301,L]
    # Rutas internas de WordPress: ya no existen (corta a los bots que las buscan).
    RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L]
    RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [G,L]
</IfModule>
