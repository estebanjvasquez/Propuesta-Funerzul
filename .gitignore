# --- Secretos del backend (NO versionar) ---
api/config.php

# --- Fotos subidas: viven en el disco del servidor, no en el repo ---
uploads/obituarios/*
!uploads/obituarios/_placeholder.webp
!uploads/obituarios/.htaccess

# --- Adjuntos de contratos de previsión: solo se versiona el .htaccess ---
uploads/prevision/*
!uploads/prevision/.htaccess

# --- Cache local de catálogo de Prevision-Funeraria (ver api/lib/prevision_funeraria.php) ---
cache/prevision_funeraria/*
!cache/prevision_funeraria/.gitkeep

# --- Respaldo del sistema SIEMPRE (1+ GB, supera el límite de GitHub) ---
database/SIEMPRE.sql

# --- Video y frames del flujo de referencia (análisis local, muy pesado) ---
flujo/

# --- Grafo de conocimiento generado localmente (graphify) ---
graphify-out/

# --- Sistema ---
.DS_Store
Thumbs.db
*.log

# --- Temporales ---
COMMIT_MSG.tmp
_preview_*.png
